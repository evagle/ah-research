{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ah-research.local/schemas/financial-redflag-mode-b-response-v1.json",
  "type": "object",
  "required": [
    "schema_version",
    "terminal_status",
    "failure_reason",
    "target_sections",
    "draft_section",
    "risk_counts",
    "valuation_blocked",
    "manual_review_required",
    "filing_manifest_sha256",
    "event_manifest_sha256",
    "counterpart_filing_manifest_sha256s",
    "action_requests",
    "confidence",
    "citations",
    "findings",
    "unresolved_items"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "terminal_status": {
      "enum": [
        "completed",
        "manual_review",
        "output_quality_failure",
        "dependency_failure"
      ]
    },
    "failure_reason": {"type": ["string", "null"]},
    "target_sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"const": "part4/§4.5"}
    },
    "draft_section": {"type": "string"},
    "risk_counts": {
      "type": "object",
      "required": ["warning", "high_risk", "veto", "pending"],
      "properties": {
        "warning": {"type": "integer", "minimum": 0},
        "high_risk": {"type": "integer", "minimum": 0},
        "veto": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "valuation_blocked": {"type": "boolean"},
    "manual_review_required": {"type": "boolean"},
    "filing_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "event_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "counterpart_filing_manifest_sha256s": {
      "type": "object",
      "propertyNames": {"enum": ["SH", "SZ", "HK"]},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "action_requests": {"type": "array"},
    "confidence": {"enum": ["high", "medium", "low", "manual_review"]},
    "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "unresolved_items": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "finding": {
      "type": "object",
      "required": [
        "canonical_finding_id",
        "owner_skill",
        "judgment_domain",
        "finding_type",
        "subject_type",
        "subject_id",
        "occurrence_date",
        "canonical_evidence_ids",
        "severity",
        "evidence_grade",
        "judgment",
        "citation_ids"
      ],
      "properties": {
        "canonical_finding_id": {"$ref": "#/$defs/sha256"},
        "owner_skill": {"const": "financial-redflag-scan"},
        "judgment_domain": {"const": "company_financials"},
        "finding_type": {"type": "string", "minLength": 1},
        "subject_type": {"const": "listed_company"},
        "subject_id": {"type": "string", "minLength": 1},
        "occurrence_date": {"type": "string", "format": "date"},
        "canonical_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "severity": {
          "enum": ["none", "warning", "high_risk", "veto", "pending"]
        },
        "evidence_grade": {"enum": ["high", "medium", "low", "manual_review"]},
        "judgment": {"type": "string", "minLength": 1},
        "citation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        }
      },
      "additionalProperties": false
    },
    "commonCitation": {
      "type": "object",
      "required": [
        "section_id",
        "jurisdiction",
        "source_type",
        "artifact_path",
        "artifact_sha256",
        "page",
        "quote"
      ],
      "properties": {
        "section_id": {"const": "part4/§4.5"},
        "jurisdiction": {"enum": ["SH", "SZ", "HK"]},
        "source_type": {"enum": ["filing_text", "filing_pdf", "event_document"]},
        "artifact_path": {"type": "string", "pattern": "^/"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "quote": {"type": "string", "minLength": 1},
        "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
        "event_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "document_url": {"type": "string", "format": "uri"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "citation": {
      "oneOf": [
        {
          "allOf": [
            {"$ref": "#/$defs/commonCitation"},
            {
              "required": ["source_pdf_sha256"],
              "properties": {
                "source_type": {"enum": ["filing_text", "filing_pdf"]},
                "page": {"type": "integer", "minimum": 1}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/commonCitation"},
            {
              "required": [
                "event_manifest_sha256",
                "document_url",
                "content_sha256"
              ],
              "properties": {"source_type": {"const": "event_document"}}
            }
          ]
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"terminal_status": {"const": "completed"}}},
      "then": {
        "properties": {
          "failure_reason": {"const": null},
          "draft_section": {"minLength": 1},
          "manual_review_required": {"const": false},
          "citations": {"minItems": 1},
          "unresolved_items": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"terminal_status": {"const": "manual_review"}}},
      "then": {
        "properties": {
          "failure_reason": {"type": "string", "minLength": 1},
          "draft_section": {"minLength": 1},
          "manual_review_required": {"const": true},
          "valuation_blocked": {"const": true},
          "citations": {"minItems": 1},
          "unresolved_items": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal_status": {
            "enum": ["output_quality_failure", "dependency_failure"]
          }
        }
      },
      "then": {
        "properties": {
          "failure_reason": {"type": "string", "minLength": 1},
          "draft_section": {"maxLength": 0},
          "manual_review_required": {"const": true},
          "valuation_blocked": {"const": true}
        }
      }
    }
  ]
}
