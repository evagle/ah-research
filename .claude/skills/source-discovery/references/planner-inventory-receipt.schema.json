{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ah-research-source-discovery.local/planner-inventory-receipt.schema.json",
  "title": "Planner Inventory Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "request_scope_fingerprint",
    "planner_inputs",
    "planner_input_fingerprint",
    "route_inventory",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "request_scope_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "planner_inputs": {
      "$ref": "#/$defs/plannerInputs"
    },
    "planner_input_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "route_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "content_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plannerInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_identity",
        "source_function",
        "maintained_profiles",
        "relation_records",
        "bound_routes",
        "as_of",
        "effective_planning_time",
        "vocabulary_identity",
        "reachability_identity",
        "route_inventory_sha256"
      ],
      "properties": {
        "request_identity": {
          "$ref": "#/$defs/requestIdentity"
        },
        "source_function": {
          "type": "string",
          "minLength": 1
        },
        "maintained_profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/maintainedProfile"
          }
        },
        "relation_records": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relationRecord"
          }
        },
        "bound_routes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/boundRoute"
          }
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "effective_planning_time": {
          "type": "string",
          "format": "date-time"
        },
        "vocabulary_identity": {
          "$ref": "#/$defs/contentIdentity"
        },
        "reachability_identity": {
          "$ref": "#/$defs/contentIdentity"
        },
        "route_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "requestIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "request_scope_fingerprint",
        "request_content_sha256"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "request_scope_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "request_content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "contentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256"],
      "properties": {
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "maintainedProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "content_sha256"],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "relationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "relation",
        "source_id",
        "source_function",
        "direct_url",
        "source_binding_sha256"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "enum": [
            "direct-peer",
            "category-leader",
            "active-listing-applicant",
            "recent-listing-applicant"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_function": {
          "type": "string",
          "minLength": 1
        },
        "direct_url": {
          "type": "string",
          "format": "uri"
        },
        "source_binding_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "boundRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "subject_relation",
        "document_type",
        "route_binding_sha256"
      ],
      "properties": {
        "route_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_relation": {
          "type": "string",
          "minLength": 1
        },
        "document_type": {
          "type": "string",
          "minLength": 1
        },
        "route_binding_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "route_layer",
        "subject_relation",
        "document_type"
      ],
      "properties": {
        "route_id": {
          "type": "string",
          "minLength": 1
        },
        "route_layer": {
          "type": "integer",
          "minimum": 0
        },
        "subject_relation": {
          "type": "string",
          "minLength": 1
        },
        "document_type": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
